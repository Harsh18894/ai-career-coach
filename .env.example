# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenAI API key. Server-side only — it is never exposed to the browser.
# Used by every model call in lib/ai/coach.ts and by the eval suite's judge.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: abuse + spend protection (lib/rate-limit.ts)
#
# This app is a public demo with no auth, so anyone who finds the URL can spend
# against OPENAI_API_KEY. The three limits below (5 new sessions/hour/IP,
# 60 LLM calls/hour/IP, and a global daily USD ceiling) are what make it safe
# to leave online.
#
# If the two Upstash vars are absent, rate limiting and the spend cap are
# DISABLED and every request is allowed, after one warning logged at startup.
# That is intentional so `npm run dev` works with no external setup — but a
# deployed instance should always set them.
#
# Get both from a free Upstash Redis database: https://console.upstash.com
# (create database -> "REST API" tab -> UPSTASH_REDIS_REST_URL / _TOKEN).
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ceiling on total estimated spend across ALL visitors per UTC day, in USD.
# Once exceeded, LLM-backed routes return a friendly "demo limit reached for
# today" response until UTC midnight. Defaults to 5.00 if unset or invalid.
# The running total is written by lib/telemetry.ts and read by lib/rate-limit.ts.
DAILY_BUDGET_USD=5.00
