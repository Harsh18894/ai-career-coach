# Copy to .env.local and fill in. Never commit .env.local.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# OpenAI API key. Server-side only — it is never exposed to the browser.
# Used by every model call in lib/ai/coach.ts and by the eval suite's judge.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: abuse + spend protection (lib/rate-limit.ts)
#
# This app is a public demo with no auth, so anyone who finds the URL can spend
# against OPENAI_API_KEY. The three limits below (5 new sessions/hour/IP,
# 60 LLM calls/hour/IP, and a global daily USD ceiling) are what make it safe
# to leave online.
#
# If the two Upstash vars are absent, rate limiting and the spend cap are
# DISABLED and every request is allowed, after one warning logged at startup.
# That is intentional so `npm run dev` works with no external setup — but a
# deployed instance should always set them.
#
# Get both from a free Upstash Redis database: https://console.upstash.com
# (create database -> "REST API" tab -> UPSTASH_REDIS_REST_URL / _TOKEN).
# ---------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ceiling on total estimated spend across ALL visitors per UTC day, in USD.
# Once exceeded, LLM-backed routes return a friendly "demo limit reached for
# today" response until UTC midnight. Defaults to 5.00 if unset or invalid.
# The running total is written by lib/telemetry.ts and read by lib/rate-limit.ts.
DAILY_BUDGET_USD=5.00

# ---------------------------------------------------------------------------
# Optional: bot protection (lib/bot-protection.ts)
#
# Cloudflare Turnstile, in invisible mode, on session-creation entry points
# only — starting a coaching session and starting a resume review. Chat turns
# are deliberately NOT gated: a challenge between a person and their next
# sentence would cost more than the abuse it prevents.
#
# Why this is here at all: the per-IP limits assume one caller has one IP. A
# public link attracts scripted traffic that does not, and a proxy pool turns
# "5 sessions per hour" into "5 per hour, per address". This is the layer that
# asks whether there is a browser at the other end.
#
# If these are absent the check is SKIPPED and every request is allowed, the
# same way the Upstash vars above disable rate limiting — so local development
# needs no Cloudflare account.
#
# Behaviour when configured:
#   token rejected by Cloudflare -> request refused (fail closed)
#   Cloudflare unreachable       -> request allowed, logged as
#                                   bot_check_degraded (fail open, degrading
#                                   to the rate limiter and daily budget)
#
# Get both from https://dash.cloudflare.com -> Turnstile -> Add site.
# Set the widget mode to "Invisible" there; this app assumes it.
#
# NOTE: the site key is PUBLIC by design (NEXT_PUBLIC_, embedded in the page).
# The secret key must never be. Do not swap them.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Optional: eval harness knobs (evals/config.ts)
#
# Only read by `npm run eval*`. The app itself never looks at these — they are
# here so `grep process.env` and this file agree, which is the only way to
# trust that nothing undocumented is being read at runtime.
# ---------------------------------------------------------------------------

# Set to 1 for the free, snapshot-cached run (what `npm run eval:cheap` sets).
# Anything else runs live against the OpenAI API and costs tokens.
EVAL_CHEAP=

# Model used by the LLM-as-judge evals. Defaults to gpt-5-nano.
JUDGE_MODEL=

# Label recorded in eval reports for which coach model produced a run, so a
# report can be attributed after the fact. Defaults to openai:gpt-5-nano.
COACH_MODEL=
